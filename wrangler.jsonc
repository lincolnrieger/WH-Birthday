{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woodhouse-party-enquiries",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker first so the dashboard is behind the login
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "woodhouse-enquiries",
      // Replace with the id printed by: npx wrangler d1 create woodhouse-enquiries
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SHEET_ID": "1qnZ28Wvc_s_soJjGve_hlsp7WGN_Qb0e7g2BZlPVATg",
    "SHEET_TAB": "Form Responses 1"
  },
  "observability": { "enabled": true }
}
