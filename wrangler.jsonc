{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "woodhouse-party-enquiries",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker first so the dashboard is behind the login
    "run_worker_first": true
  },
  "vars": {
    // The Google Sheet the form saves to: the part of its web address between /d/ and /edit
    "SHEET_ID": "1qnZ28Wvc_s_soJjGve_hlsp7WGN_Qb0e7g2BZlPVATg",
    // The tab with the form responses
    "SHEET_TAB": "Form Responses 1"
  },
  "observability": { "enabled": true }
}
